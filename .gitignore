# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Distribution / packaging
.Python
build/
dist/
*.egg-info/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test & debug scripts (contain hardcoded tokens). Root-level scratch scripts
# are ignored; tests/ holds the committed suite and is re-included below.
/ha_test_*.py
/test_*.py
/check_*.py
/fix_*.py
/update_*.py
tmp/

# The committed suite lives in tests/ and must not be swallowed by the
# scratch-script patterns above. Bytecode inside it stays ignored.
!tests/
!tests/*.py
!tests/*.txt

# Reverse engineering / security-sensitive analysis
REVERSE_ENGINEERING.md

# Local scratch files (reverse-engineering artifacts, not part of integration)
applet_copy.db
ha_check_remote.py
query_applet_db.py
